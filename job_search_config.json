      "2 - 3 years",
      "0-2 years",
      "0 - 2 years",
      "0-3 years",
      "0 - 3 years",
      "less than 3 years",
      "below 3 years",
      "entry level",
      "fresher",
      "junior",
      "associate"
    ],
    "exclude": [
      "3+ years",
      "4+ years",
      "5+ years",
      "6+ years",
      "7+ years",
      "8+ years",
      "senior",
      "lead",
      "principal",
      "staff engineer",
